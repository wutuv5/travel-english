{
  "name": "TravelEnglish",
  "options": {
    "bundleIdPrefix": "local.travelenglish",
    "deploymentTarget": { "iOS": "18.0" },
    "developmentLanguage": "zh-Hans"
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1",
      "CODE_SIGNING_ALLOWED": "NO",
      "MARKETING_VERSION": "0.1.0",
      "CURRENT_PROJECT_VERSION": "1"
    }
  },
  "targets": {
    "TravelEnglish": {
      "type": "application",
      "platform": "iOS",
      "sources": ["TravelEnglish"],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.travelenglish.app",
          "GENERATE_INFOPLIST_FILE": "YES",
          "INFOPLIST_KEY_CFBundleDisplayName": "旅前英语",
          "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.education",
          "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
          "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
          "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight"
        }
      }
    }
  },
  "schemes": {
    "TravelEnglish": {
      "build": { "targets": { "TravelEnglish": "all" } },
      "run": { "config": "Debug" },
      "archive": { "config": "Release" }
    }
  }
}
